# Activate renv if the project library exists
if (is.null(getOption("repos")) || identical(unname(getOption("repos")["CRAN"]), "@CRAN@")) {
  options(repos = c(CRAN = "https://cloud.r-project.org"))
}
source("renv/activate.R")

# Stable CRAN mirror
options(repos = c(CRAN = "https://cloud.r-project.org"))